import { NavigationContainer } from '@react-navigation/native';
import { createNativeStackNavigator } from '@react-navigation/native-stack';
import AsyncStorage from '@react-native-async-storage/async-storage';

const Stack = createNativeStackNavigator();
  const [isSearchVisible, setIsSearchVisible] = useState(false);
  const [searchText, setSearchText] = useState('');

  useEffect(() => {
    const loadData = async () => {
      try {
        const savedContacts = await AsyncStorage.getItem('@contacts_data');
        if (savedContacts !== null) {
          setContacts(JSON.parse(savedContacts));
        }
      } catch (e) {
        console.log('Error loading data', e);
      }
    };
    loadData();
  }, []);

  useEffect(() => {
    const saveData = async () => {
      try {
        await AsyncStorage.setItem('@contacts_data', JSON.stringify(contacts));
      } catch (e) {
        console.log('Error saving data', e);
      }
    };
    if (contacts.length > 0 || (contacts.length === 0 && isSearchVisible === false)) {
        saveData();
    }
  }, [contacts]);

  const availableLetters = ['الكل', ...new Set(contacts.map(c => c.letter))].sort();

  const filteredContacts = contacts.filter(contact => {
    const matchesLetter = selectedLetter === 'الكل' || contact.letter === selectedLetter;
    const matchesSearch = contact.name.includes(searchText) || (contact.phone && contact.phone.includes(searchText));
    return matchesLetter && matchesSearch;
  });

  return (
    <View style={styles.container}>
      <View style={styles.header}>
        <Text style={styles.headerText}>اسامی افراد</Text>
        <TouchableOpacity style={styles.searchIcon} onPress={() => setIsSearchVisible(!isSearchVisible)}>
          <Text style={styles.searchIconText}>🔍</Text>
        </TouchableOpacity>
      </View>

      {isSearchVisible && (
        <View style={styles.searchContainer}>
          <TextInput style={styles.searchInput} placeholder="جستجوی نام یا شماره..." value={searchText} onChangeText={setSearchText} autoFocus={true} />
        </View>
      )}

      <View style={styles.alphabetContainer}>
        <ScrollView horizontal showsHorizontalScrollIndicator={false} contentContainerStyle={styles.alphabetScroll}>
          {availableLetters.map((letter) => (
            <TouchableOpacity key={letter} style={[styles.letterButton, selectedLetter === letter && styles.letterButtonActive]} onPress={() => setSelectedLetter(letter)}>
              <Text style={[styles.letterText, selectedLetter === letter && styles.letterTextActive]}>{letter}</Text>
            </TouchableOpacity>
          ))}
        </ScrollView>
      </View>

      <ScrollView style={styles.listContainer}>
        {filteredContacts.length === 0 && (
          <Text style={styles.emptyText}>{contacts.length === 0 ? 'لیست خالی است. با دکمه + شخص جدید اضافه کنید.' : 'موردی پیدا نشد.'}</Text>
        )}

        {filteredContacts.map((contact) => (
          <TouchableOpacity key={contact.id} style={styles.listItem} onPress={() => navigation.navigate('CustomerDetail', { contact, contacts, setContacts })}>
            <Text style={styles.listItemText}>{contact.name}</Text>
            {contact.phone ? <Text style={styles.phoneText}>{contact.phone}</Text> : null}
          </TouchableOpacity>
        ))}
      </ScrollView>

      <TouchableOpacity style={styles.floatingButton} onPress={() => navigation.navigate('AddNew', { setContacts, contacts })}>
        <Text style={styles.floatingButtonText}>+</Text>
      </TouchableOpacity>
    </View>
  );
}

// ---------------------------------------------------------
// صفحه ثبت شخص جدید و ویرایش
// ---------------------------------------------------------
function AddNewScreen({ navigation, route }) {
  const { setContacts, contacts, editContact } = route.params;
  
  // اگر در حالت ویرایش بودیم، مقادیر قبلی پر میشوند
  const [name, setName] = useState(editContact ? editContact.name : '');
  const [phone, setPhone] = useState(editContact ? editContact.phone : '');
  const [email, setEmail] = useState(editContact ? editContact.email : '');
  const [address, setAddress] = useState(editContact ? editContact.address : '');
  const [carryForward, setCarryForward] = useState(editContact ? editContact.carryForward : false);

  const handleSave = () => {
    if (name.trim() === '') {
      Alert.alert('خطا', 'لطفاً نام شخص را وارد کنید.');
      return;
    }

    const firstLetter = name.trim().charAt(0);

    if (editContact) {
      // حالت ویرایش
      const updatedContacts = contacts.map(c => {
        if (c.id === editContact.id) {
          return { ...c, name: name.trim(), phone: phone.trim(), letter: firstLetter, email: email.trim(), address: address.trim(), carryForward: carryForward };
        }
        return c;
      });
      setContacts(updatedContacts);
    } else {
      // حالت ثبت جدید
      const newContact = {
        id: Date.now().toString(),
        name: name.trim(),
        phone: phone.trim(),
        letter: firstLetter,
        email: email.trim(),
        address: address.trim(),
        carryForward: carryForward,
        transactions: [] 
      };
      setContacts([...contacts, newContact]);
    }
    
    navigation.goBack(); 
  };

  useLayoutEffect(() => {
    navigation.setOptions({
      title: editContact ? 'Edit Customer' : 'Customer Detail',
      headerRight: () => (
        <TouchableOpacity onPress={handleSave} style={{ padding: 10 }}>
          <Text style={{ color: '#fff', fontSize: 24, fontWeight: 'bold' }}>✓</Text>
        </TouchableOpacity>
      ),
    });
  }, [navigation, name, phone, email, address, carryForward]);

  return (
    <KeyboardAvoidingView behavior={Platform.OS === 'ios' ? 'padding' : 'height'} style={styles.formContainer}>
      <ScrollView style={styles.formScroll}>
        <Text style={styles.label}>Name</Text>
        <TextInput style={styles.input} placeholder="Name" value={name} onChangeText={setName} />
        <Text style={styles.label}>Mobile No</Text>
        <TextInput style={styles.input} placeholder="Mobile No" value={phone} onChangeText={setPhone} keyboardType="phone-pad" />
        <Text style={styles.label}>Email Id</Text>
        <TextInput style={styles.input} placeholder="Email Id" value={email} onChangeText={setEmail} keyboardType="email-address" />
        <Text style={styles.label}>Address</Text>
        <TextInput style={[styles.input, styles.textArea]} placeholder="Address" value={address} onChangeText={setAddress} multiline={true} numberOfLines={4} />
        
        <TouchableOpacity style={styles.checkboxContainer} onPress={() => setCarryForward(!carryForward)}>
          <View style={[styles.checkbox, carryForward && styles.checkboxChecked]}>
            {carryForward && <Text style={styles.checkboxTick}>✓</Text>}
          </View>
          <Text style={styles.checkboxLabel}>Existing customer, add carry forward balance</Text>
        </TouchableOpacity>
      </ScrollView>
    </KeyboardAvoidingView>
  );
}

// ---------------------------------------------------------
// صفحه جزئیات حساب مشتری
// ---------------------------------------------------------
function CustomerDetailScreen({ navigation, route }) {
  const { contact, contacts, setContacts } = route.params;
  
  const [isModalVisible, setIsModalVisible] = useState(false);
  const [amount, setAmount] = useState('');
  const [note, setNote] = useState('');
  const [transactionType, setTransactionType] = useState(''); 

  const currentContact = contacts.find(c => c.id === contact.id) || contact;
  const transactions = currentContact.transactions || [];

  let totalPayment = 0;
  let totalCredit = 0;
  transactions.forEach(t => {
    if (t.type === 'payment') totalPayment += Number(t.amount);
    if (t.type === 'credit') totalCredit += Number(t.amount);
  });
  const netBalance = totalCredit - totalPayment;

  useLayoutEffect(() => {
    navigation.setOptions({
      title: currentContact.name,
      headerRight: () => (
        <View style={{ flexDirection: 'row' }}>
          {/* دکمه ویرایش (مداد) */}
          <TouchableOpacity style={{ marginRight: 15 }} onPress={() => navigation.navigate('AddNew', { setContacts, contacts, editContact: currentContact })}>
            <Text style={{ fontSize: 20 }}>✏️</Text>
          </TouchableOpacity>
          <TouchableOpacity style={{ marginRight: 15 }}><Text style={{ fontSize: 20 }}>📞</Text></TouchableOpacity>
          <TouchableOpacity><Text style={{ fontSize: 20 }}>📤</Text></TouchableOpacity>
        </View>
      ),
    });
  }, [navigation, currentContact]);

  const openTransactionModal = (type) => {
    setTransactionType(type);
    setAmount('');
    setNote('');
    setIsModalVisible(true);
  };

  const handleSaveTransaction = () => {
    if (amount === '' || isNaN(amount)) {
      Alert.alert('خطا', 'لطفاً یک مبلغ معتبر وارد کنید.');
      return;
    }

    const now = new Date();
    const newTransaction = {
      id: Date.now().toString(),
      type: transactionType,
      amount: amount,
      note: note,
      date: now.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }),
      time: now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' })
    };

    const updatedContacts = contacts.map(c => {
      if (c.id === currentContact.id) {
        return { ...c, transactions: [...(c.transactions || []), newTransaction] };
      }
      return c;
    });

    setContacts(updatedContacts);
    setIsModalVisible(false);
  };

  // تابع حذف مشتری
  const handleDeleteCustomer = () => {
    Alert.alert(
      'حذف مشتری',
      `آیا مطمئنی می‌خواهی "${currentContact.name}" را به طور کامل حذف کنی؟`,
      [
        { text: 'انصراف', style: 'cancel' },
        { 
          text: 'حذف', 
          style: 'destructive', 
          onPress: () => {
            const updatedContacts = contacts.filter(c => c.id !== currentContact.id);
            setContacts(updatedContacts);
            navigation.goBack(); // برگشت به صفحه اصلی
          } 
        }
      ]
    );
  };

  const now = new Date();
  const currentDateStr = now.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
  const currentTimeStr = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });

  return (
    <View style={styles.detailContainer}>
      <View style={styles.actionButtonsContainer}>
        <TouchableOpacity style={[styles.actionButton, styles.paymentButton]} onPress={() => openTransactionModal('payment')}>
          <Text style={styles.actionButtonText}>Accept Payment</Text>
        </TouchableOpacity>
        <TouchableOpacity style={[styles.actionButton, styles.creditButton]} onPress={() => openTransactionModal('credit')}>
          <Text style={styles.actionButtonText}>Give Credit</Text>
        </TouchableOpacity>
      </View>

      <View style={styles.balanceCard}>
        <View style={{ flexDirection: 'row', alignItems: 'center' }}>
          <Text style={{ fontSize: 24, marginRight: 10 }}>💵</Text>
          <Text style={styles.balanceLabel}>Net Balance</Text>
        </View>
        <Text style={[styles.balanceAmount, { color: netBalance > 0 ? '#F44336' : '#4CAF50' }]}>
          IRR {netBalance}
        </Text>
      </View>

      <View style={styles.tableHeader}>
        <Text style={[styles.columnHeader, { flex: 1.5, textAlign: 'left' }]}>Date</Text>
        <Text style={[styles.columnHeader, { flex: 1, color: '#4CAF50' }]}>Payment</Text>
        <Text style={[styles.columnHeader, { flex: 1, color: '#F44336' }]}>Credit</Text>
      </View>

      <ScrollView style={styles.transactionsList}>
        {transactions.length === 0 && <Text style={styles.noTransactionText}>هیچ تراکنشی ثبت نشده است.</Text>}
        {transactions.map((t) => (
          <View key={t.id} style={styles.transactionRow}>
            <View style={{ flex: 1.5 }}>
              <Text style={styles.dateText}>{t.date}</Text>
              <Text style={styles.timeText}>{t.time}</Text>
            </View>
            <Text style={[styles.amountText, { flex: 1, color: '#4CAF50' }]}>
              {t.type === 'payment' ? `IRR ${t.amount}` : '-'}
            </Text>
            <Text style={[styles.amountText, { flex: 1, color: '#F44336' }]}>
              {t.type === 'credit' ? `IRR ${t.amount}` : '-'}
            </Text>
          </View>
        ))}
      </ScrollView>

      {/* دکمه حذف مشتری در پایین صفحه */}
      <TouchableOpacity style={styles.deleteButton} onPress={handleDeleteCustomer}>
        <Text style={styles.deleteButtonText}>🗑️ Settle and Delete Customer</Text>
      </TouchableOpacity>

      <Modal visible={isModalVisible} transparent={true} animationType="fade">
        <View style={styles.modalOverlay}>
          <View style={styles.modalBox}>
            
            <View style={styles.modalHeader}>
              <Text style={styles.modalHeaderText}>{transactionType === 'payment' ? 'Accept Payment' : 'Give Credit'}</Text>
              <TouchableOpacity style={styles.modalCloseBtn} onPress={() => setIsModalVisible(false)}>
                <Text style={{ fontSize: 18, color: '#000' }}>✕</Text>
              </TouchableOpacity>
            </View>

            <View style={styles.modalDateTime}>
              <Text style={styles.modalIcon}>📅</Text>
              <Text style={styles.modalDateTimeText}>{currentDateStr}</Text>
              <Text style={styles.modalIcon}>🕒</Text>
              <Text style={styles.modalDateTimeText}>{currentTimeStr}</Text>
            </View>

            <View style={styles.amountContainer}>
              <Text style={[styles.currencyLabel, { color: transactionType === 'payment' ? '#4CAF50' : '#F44336' }]}>IRR</Text>
              <TextInput
                style={styles.amountInput}
                keyboardType="numeric"
                value={amount}
                onChangeText={setAmount}
                placeholder="Amount"
                autoFocus={true}
              />
            </View>

            <Text style={styles.noteLabel}>Note:</Text>
            <TextInput
              style={styles.noteInput}
              placeholder="note"
              value={note}
              onChangeText={setNote}
            />

            <TouchableOpacity style={styles.saveModalBtn} onPress={handleSaveTransaction}>
              <Text style={styles.saveModalBtnText}>SAVE</Text>
            </TouchableOpacity>

          </View>
        </View>
      </Modal>

    </View>
  );
}

// ---------------------------------------------------------
// اتصال صفحات
// ---------------------------------------------------------
export default function App() {
  return (
    <NavigationContainer>
      <Stack.Navigator screenOptions={{ headerStyle: { backgroundColor: '#9575CD' }, headerTintColor: '#fff', headerTitleStyle: { fontWeight: 'bold' }, headerTitleAlign: 'center' }}>
        <Stack.Screen name="Home" component={HomeScreen} options={{ headerShown: false }} />
        <Stack.Screen name="AddNew" component={AddNewScreen} />
        <Stack.Screen name="CustomerDetail" component={CustomerDetailScreen} />
      </Stack.Navigator>
    </NavigationContainer>
  );
}

